# ═══════════════════════════════════════════════════════════════
# Company Bill Server — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────────
# Get from: MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/company-bill?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# ─── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── WhatsApp Business Cloud API (Meta) ─────────────────────────
# FREE: 1,000 service conversations/month
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# 1. Go to developers.facebook.com → Create App → Business → WhatsApp
# 2. Get temporary access token from API Setup page
# 3. Get Phone Number ID from the same page
# 4. Create a message template named "overdue_reminder" in WhatsApp Manager
#
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_TEMPLATE_NAME=overdue_reminder

# ─── Notification Settings ──────────────────────────────────────
# Provider options: "whatsapp_meta" | "console" (for testing)
NOTIFICATION_PROVIDER=console

# Retry configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_MS=2000

# ─── Overdue Bill Settings ──────────────────────────────────────
# Bills older than this many days are marked OVERDUE
OVERDUE_DAYS=7

# Cron schedule (default: every day at 9:00 AM IST)
# Format: minute hour day month weekday
OVERDUE_CRON_SCHEDULE=0 9 * * *
